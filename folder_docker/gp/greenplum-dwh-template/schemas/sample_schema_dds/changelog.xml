<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet author="12345678" id="sample_schema_dds:preparation_step" context="all" runOnChange="true" runAlways="true">
        <sql>
            set search_path to sample_schema_dds, public;
            alter table schemachangelog owner to sample_schema_dds_owner;
            alter table schemachangeloglock owner to sample_schema_dds_owner;
        </sql>
    </changeSet>
    <include file="init.sql" relativeToChangelogFile="true"/>
    <include file="drops.sql" relativeToChangelogFile="true"/>
    <includeAll path="sequences/" relativeToChangelogFile="true"/>
    <includeAll path="tables/" relativeToChangelogFile="true"/>
    <include file="functions/changelog.xml" relativeToChangelogFile="true"/>
    <include file="views/changelog.xml" relativeToChangelogFile="true"/>
    <include file="grants.sql" relativeToChangelogFile="true"/>

    <changeSet author="12345678" id="reset role" runAlways="true" runOnChange="true">
        <sql>RESET ROLE</sql>
    </changeSet>
</databaseChangeLog>
